{
  "name": "ethayer-design-timeline",
  "version": "0.1.0",
  "private": true,
  "description": "Career timeline wall for Eric Thayer: Swiss-poster and media bento cards with full-screen project dialogs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "npm run media && vite",
    "build": "npm run media && tsc --noEmit && npm run content:check && vite build",
    "content:check": "node scripts/check-content.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budgets": "node scripts/check-budgets.ts",
    "media": "node scripts/build-media.ts",
    "media:clip": "node scripts/capture-clip.ts",
    "check": "npm run media && npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
